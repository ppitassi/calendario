{
  "name": "presentation-calendar-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "next dev --port 3010",
    "db:migrate": "node scripts/migrate-pg.mjs",
    "build": "node scripts/migrate-pg.mjs && next build",
    "postbuild": "node scripts/prepare-standalone.cjs",
    "production:check": "node scripts/validate-production-env.cjs",
    "prestart": "npm run production:check",
    "start": "node scripts/start-production.cjs",
    "pm2:start": "npm run production:check && pm2 startOrRestart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop presentation-studio",
    "pm2:status": "pm2 status presentation-studio",
    "pm2:logs": "pm2 logs presentation-studio --lines 100",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/verify-browser.cjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^13.4.3",
    "next": "^16.3.6",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright-core": "^1.63.0",
    "pm2": "^7.0.4",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
