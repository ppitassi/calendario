PORT=3006
# Na Vercel, use o domínio público HTTPS do projeto.
APP_URL=http://localhost:3006
INTERNAL_APP_URL=http://127.0.0.1:3006
FRONTEND_URL=http://localhost:3006
COOKIE_SECURE=false
APP_TIMEZONE=America/Sao_Paulo

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=content_planner
# Preferido em produção: URL completa do MySQL gerenciado.
DATABASE_URL=
DB_SSL_MODE=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=
DB_CONNECTION_LIMIT=3

# WhatsApp / Evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=main
NOTIFY_NUMBER=

# Meta e OAuth
META_CLIENT_ID=
META_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_CONFIG_ID=
META_GRAPH_API_VERSION=v22.0
META_FACEBOOK_REDIRECT_URI=http://localhost:3006/api/integrations/meta/facebook/callback
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3006/api/integrations/meta/instagram/callback
META_INSTAGRAM_SCOPES=instagram_business_basic
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
META_JOB_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LeIA / provedor de texto — somente servidor
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Renderização de PDF
BROWSERLESS_URL=
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
CHROMIUM_PATH=
PDF_WORKER_SECRET=
PDF_JOB_CONCURRENCY=1
PDF_JOB_MAX_ATTEMPTS=3
PDF_DRAFT_RETENTION_DAYS=30
PDF_RENDER_TIMEOUT_MS=120000
PDF_MEDIA_ALLOWED_ORIGINS=
PDF_STORAGE_TIMEOUT_MS=60000
CRON_SECRET=

# Storage de mídia / Nextcloud
NEXTCLOUD_MOUNT_PATH=
NEXTCLOUD_PUBLIC_BASE_URL=
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_OCS_URL=
NEXTCLOUD_PUBLIC_DAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT=ContentPlanner
UPLOAD_STORAGE_ROOT=
UPLOAD_LOCAL_FALLBACK_ENABLED=false
NEXTCLOUD_SYNC_ENABLED=true
NEXTCLOUD_SYNC_INTERVAL_MINUTES=60
NEXTCLOUD_SYNC_BATCH_SIZE=25
NEXTCLOUD_SYNC_CONCURRENCY=1
NEXTCLOUD_SYNC_MAX_BYTES_PER_RUN=
NEXTCLOUD_SYNC_RETRY_LIMIT=8
LOCAL_MEDIA_EVICTION_ENABLED=false
LOCAL_MEDIA_EVICTION_DELAY_MINUTES=60
LOCAL_MEDIA_CACHE_MAX_GB=5
LOCAL_MEDIA_TEMP_TTL_HOURS=24
MAX_MEDIA_UPLOAD_GB=20
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Web Push — a chave privada nunca vai para o cliente
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
