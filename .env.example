# Desenvolvimento: copie para `.env.local`.
# Produção: copie para `.env.production.local` e use volumes absolutos.
PORT=3010
HOSTNAME=127.0.0.1

# OBRIGATÓRIO em produção: volumes já criados, absolutos, persistentes e graváveis.
STUDIO_DATA_DIR=
STUDIO_UPLOAD_DIR=

# Obrigatórios no ambiente; aplicados somente quando o SQLite ainda não tem administrador.
STUDIO_ADMIN_USERNAME=admin
STUDIO_ADMIN_NAME=Administrador
STUDIO_ADMIN_PASSWORD=

# Limite individual de upload em megabytes.
STUDIO_UPLOAD_MAX_MB=10
