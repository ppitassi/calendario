PORT=3006
# Na Vercel, use o domínio público HTTPS do projeto.
APP_URL=http://localhost:3006
INTERNAL_APP_URL=http://127.0.0.1:3006
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3006

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=content_planner

# Preferido na Vercel: URL completa do MySQL gerenciado.
# Exemplo: mysql://usuario:senha@host:3306/content_planner?ssl-mode=REQUIRED
DATABASE_URL=
DB_SSL_MODE=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=
DB_CONNECTION_LIMIT=3

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=main
NOTIFY_NUMBER=

META_CLIENT_ID=
META_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LeIA / provedor de texto ─────────────────────────────────────────────
# Provedor ativo: Groq. Estas variáveis são exclusivas do servidor.
# Nunca use NEXT_PUBLIC_GROQ_API_KEY e nunca envie a chave ao navegador.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Renderização de PDF na Vercel. Use o WebSocket CDP de um Browserless externo.
BROWSERLESS_URL=

# O Vercel Cron envia este valor em Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
APP_TIMEZONE=America/Sao_Paulo

# A integração central fica em lib/leia.ts. Para trocar de provedor,
# substitua a implementação de completeWithLeia, mantendo sua assinatura.
#
# OLLAMA (local, sem chave):
# 1. Instale o Ollama e baixe um modelo: ollama pull llama3.2:3b
# 2. Use OLLAMA_BASE_URL e OLLAMA_MODEL abaixo.
# 3. Em lib/leia.ts, envie messages para POST /api/chat e leia message.content.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
#
# GEMINI (Google):
# 1. Instale o SDK oficial: npm install @google/genai
# 2. Crie GEMINI_API_KEY no servidor e escolha um modelo disponível.
# 3. Em lib/leia.ts, troque o cliente Groq pelo GoogleGenAI e adapte
#    messages/responseFormat; mantenha completeWithLeia retornando string.
# GEMINI_API_KEY=
# GEMINI_MODEL=
#
# GPT (OpenAI):
# 1. Instale o SDK oficial: npm install openai
# 2. Crie OPENAI_API_KEY no servidor e defina OPENAI_MODEL.
# 3. Em lib/leia.ts, use a Responses API e retorne response.output_text.
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# GROK (xAI; não confundir com Groq):
# 1. Crie XAI_API_KEY no servidor e escolha um modelo disponível na xAI.
# 2. Em lib/leia.ts, use a API/SDK da xAI, converta messages e retorne texto.
# 3. Preserve rate limit, timeout, contexto de tenant e validação existentes.
# XAI_API_KEY=
# XAI_MODEL=

# ── Storage de mídia / Nextcloud ──────────────────────────────────────────────
# Opção recomendada quando o disco virtual do Nextcloud está montado no servidor:
# arquivos pesados são gravados diretamente nele, sem ocupar o disco da aplicação.
NEXTCLOUD_MOUNT_PATH=
NEXTCLOUD_PUBLIC_BASE_URL=

# Alternativa sem disco montado: upload por WebDAV + link público criado via OCS.
# Exemplo WebDAV: https://cloud.exemplo.com/remote.php/dav/files/USUARIO
# Exemplo OCS:    https://cloud.exemplo.com/ocs/v2.php/apps/files_sharing/api/v1
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_OCS_URL=
NEXTCLOUD_PUBLIC_DAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT=ContentPlanner

# Limite aceito pelo endpoint de mídia pesada. Ajuste também proxy e Nextcloud.
MAX_MEDIA_UPLOAD_GB=20

# Compatibilidade com funções maiores quando o projeto Vercel solicitar opt-in.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
